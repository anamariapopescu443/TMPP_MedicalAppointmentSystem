@model MedicalAppointmentSystem.Domain.Models.Patient

<h2 class="page-title">My Profile</h2>

<p class="section-subtitle">
    Manage your personal information and medical card.
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="profile-header-card mb-4">
    <div class="profile-avatar">
        @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
    </div>

    <div>
        <h3>@Model.FullName</h3>
        <p>@Model.Email</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="profile-card h-100">
            <div class="profile-card-header">
                <div>
                    <h4>Personal Information</h4>
                    <p>Update your contact and identification details.</p>
                </div>
                <span class="profile-card-icon">👤</span>
            </div>

            <form asp-action="UpdateProfile" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <input name="firstName" value="@Model.FirstName" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <input name="lastName" value="@Model.LastName" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input name="phoneNumber" value="@Model.PhoneNumber" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input name="email" value="@Model.Email" type="email" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">IDNP</label>
                        <input name="idnp" value="@Model.IDNP" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date of Birth</label>
                        <input name="dateOfBirth"
                               value="@Model.DateOfBirth.ToString("yyyy-MM-dd")"
                               type="date"
                               class="form-control"
                               required />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="profile-card h-100">
            <div class="profile-card-header">
                <div>
                    <h4>Medical Card</h4>
                    <p>Upload and manage your medical document.</p>
                </div>
                <span class="profile-card-icon">📄</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.MedicalCardFilePath))
            {
                <div class="medical-card-status uploaded">
                    <div>
                        <strong>Medical card uploaded</strong>
                        <p>Your current medical card is available for viewing.</p>
                    </div>

                    <a href="@Model.MedicalCardFilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                        View file
                    </a>
                </div>
            }
            else
            {
                <div class="medical-card-status missing">
                    <div>
                        <strong>No medical card uploaded</strong>
                        <p>Please upload a PDF, JPG or PNG document.</p>
                    </div>
                </div>
            }

            <form asp-action="UploadMedicalCard" method="post" enctype="multipart/form-data" class="mt-4">
                <label class="form-label">Upload Medical Card</label>

                <div class="upload-box">
                    <input name="medicalCard"
                           type="file"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png"
                           required />

                    <small>Accepted formats: PDF, JPG, PNG.</small>
                </div>

                <button type="submit" class="btn btn-primary mt-3">
                    Upload Medical Card
                </button>
            </form>
        </div>
    </div>
</div>