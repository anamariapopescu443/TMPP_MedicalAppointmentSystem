@{
    var role = Context.Session.GetString("UserRole");
    var fullName = Context.Session.GetString("FullName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical Appointment System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MedicalAppointmentSystem.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="app-navbar-wrapper">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-symbol">✚</span>
                    Medical Appointment System
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav app-nav-links me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Hospitals" asp-action="Index">Hospitals</a>
                        </li>

                        @if (role == "Patient")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PatientDashboard" asp-action="Index">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">Notifications</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PatientProfile" asp-action="Index">Profile</a>
                            </li>
                        }

                        @if (role == "Doctor")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DoctorDashboard" asp-action="Index">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a>
                            </li>

                            @* <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointments" asp-action="Index" asp-route-filter="confirmed">Confirmed</a>
                            </li> *@

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DoctorProfile" asp-action="Index">Profile</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav app-user-area ms-auto">
                        @if (string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm me-2" asp-controller="Account" asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <div class="user-chip">
                                    <span class="user-avatar">
                                        @(role == "Patient" ? "P" : "D")
                                    </span>

                                    <div class="user-text">
                                        <strong>@fullName</strong>
                                        <small>@role</small>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item" style="align-content: center;">
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container app-main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Medical Appointment System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>