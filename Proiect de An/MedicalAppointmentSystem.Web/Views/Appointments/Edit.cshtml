@model MedicalAppointmentSystem.Domain.Models.Appointment

<h2 class="page-title">Edit Appointment</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Patient ID</label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Doctor ID</label>
        <input asp-for="DoctorId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Medical Service ID</label>
        <input asp-for="MedicalServiceId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Appointment Date</label>
        <input asp-for="AppointmentDate" type="datetime-local" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Reason</label>
        <textarea asp-for="Reason" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn abc">Back</a>
</form>