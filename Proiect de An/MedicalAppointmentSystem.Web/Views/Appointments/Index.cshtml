@model List<MedicalAppointmentSystem.Domain.Models.Appointment>
@using MedicalAppointmentSystem.Domain.Enums

@{
    var role = ViewBag.Role as string;
}

<div class="page-header-card mb-4">
    <div>

        <h2 class="page-title mb-1">
            @if (role == "Patient")
            {
                <span>My Appointment History</span>
            }
            else if (role == "Doctor")
            {
                <span>My Appointment Requests</span>
            }
            else
            {
                <span>Appointments</span>
            }
        </h2>

        <p class="section-subtitle mb-0">
            Track appointments, statuses, comments and medical services in one place.
        </p>
    </div>

    @if (role == "Patient")
    {
        <a asp-action="Create" class="btn btn-primary">
            Create Appointment
        </a>
    }
</div>

@if (role == "Doctor")
{
    <div class="filter-card mb-4">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 flex-wrap">
            <label class="form-label mb-0">Filter appointments:</label>

            <select name="filter" class="form-control" style="width: 220px;">
                <option value="all" selected="@(ViewBag.Filter == "all")">All</option>
                <option value="today" selected="@(ViewBag.Filter == "today")">Today</option>
                <option value="tomorrow" selected="@(ViewBag.Filter == "tomorrow")">Tomorrow</option>
                <option value="pending" selected="@(ViewBag.Filter == "pending")">Pending</option>
                <option value="confirmed" selected="@(ViewBag.Filter == "confirmed")">Confirmed</option>
                <option value="completed" selected="@(ViewBag.Filter == "completed")">Completed</option>
                <option value="declined" selected="@(ViewBag.Filter == "declined")">Declined</option>
            </select>

            <button type="submit" class="btn btn-primary">
                Apply
            </button>
        </form>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="appointments-table-card">
    <div class="table-responsive">
        <table class="table appointments-table mb-0">
            <colgroup>
                <col style="width: 8%;" />
                <col style="width: 12%;" />
                <col style="width: 9%;" />
                <col style="width: 10%;" />
                <col style="width: 10%;" />
                <col style="width: 8%;" />
                <col style="width: 7%;" />
                <col style="width: 12%;" />
                <col style="width: 12%;" />
                <col style="width: 12%;" />
            </colgroup>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Institution</th>
                    <th>Doctor</th>
                    <th>Service</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Type</th>
                    <th>Reason</th>
                    <th>Doctor Comment</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Patient?.FullName</strong>
                        </td>

                        <td>
                            <strong>@item.Hospital?.Name</strong>
                            <div class="small text-muted">@item.Hospital?.Type</div>
                            <div class="small">@item.Department?.Name</div>
                        </td>

                        <td>
                            @item.Doctor?.FullName
                        </td>

                        <td>
                            @item.MedicalService?.Name
                        </td>

                        <td>
                            <strong>@item.AppointmentDate.ToString("yyyy-MM-dd")</strong>
                            <div class="small text-muted">@item.AppointmentDate.ToString("HH:mm")</div>
                        </td>

                        <td>
                            @if (item.Status == AppointmentStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == AppointmentStatus.Confirmed)
                            {
                                <span class="badge bg-primary">Confirmed</span>
                            }
                            else if (item.Status == AppointmentStatus.Completed)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (item.Status == AppointmentStatus.Declined)
                            {
                                <span class="badge bg-danger">Declined</span>
                            }
                            else if (item.Status == AppointmentStatus.Cancelled)
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                @item.Type
                            </span>
                        </td>

                        <td>
                            <div class="text-clamp">
                                @item.Reason
                            </div>
                        </td>

                        <td>
                            <div class="text-clamp">
                                @item.DoctorComment
                            </div>
                        </td>

                        <td class="actions-cell text-end">
                            <div class="d-flex flex-column gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                @if (role == "Patient" && item.Status == AppointmentStatus.Pending)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                }

                                @if (role == "Doctor")
                                {
                                    @if (item.Status == AppointmentStatus.Pending)
                                    {
                                        <form asp-action="Confirm" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-success w-100">
                                                Confirm
                                            </button>
                                        </form>

                                        <form asp-action="Decline" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-danger w-100" style="margin-bottom: 10px;">
                                                Decline
                                            </button>

                                            <input name="declineReason"
                                                   placeholder="Decline reason"
                                                   class="form-control form-control-sm mb-1"
                                                   required />
                                        </form>
                                    }

                                    @if (item.Status == AppointmentStatus.Confirmed)
                                    {
                                        <form asp-action="Complete" asp-route-id="@item.Id" method="post">
                                            <input name="doctorComment"
                                                   placeholder="Doctor comment"
                                                   class="form-control form-control-sm mb-1"
                                                   required />

                                            <button type="submit" class="btn btn-sm btn-secondary w-100">
                                                Complete
                                            </button>
                                        </form>
                                    }

                                    @if (item.Status == AppointmentStatus.Completed)
                                    {
                                        <form asp-action="CreateFollowUp" asp-route-id="@item.Id" method="post">
                                            <input name="followUpDate"
                                                   type="datetime-local"
                                                   class="form-control form-control-sm mb-1"
                                                   required />

                                            <button type="submit" class="btn btn-sm btn-info w-100">
                                                Create Follow-up
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>