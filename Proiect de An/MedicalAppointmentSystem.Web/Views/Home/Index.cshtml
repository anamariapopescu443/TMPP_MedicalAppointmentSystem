@{
    var role = ViewBag.Role as string;
    var fullName = ViewBag.FullName as string;
}

<div class="hero-section mb-4">
    <div class="row align-items-center">
        <div class="col-lg-7">

            <h1 class="hero-title">
                Medical Appointment System
            </h1>

            <p class="hero-text">
                A modern web platform for managing medical appointments between patients, doctors,
                hospitals and departments.
            </p>

            @if (string.IsNullOrEmpty(role))
            {
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                        Create Account
                    </a>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">
                        Login
                    </a>
                </div>
            }
            else if (role == "Patient")
            {
                <p class="hero-welcome">
                    Welcome back, <strong>@fullName</strong>.
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Appointments" asp-action="Create" class="btn btn-light btn-lg">
                        Make Appointment
                    </a>

                    <a asp-controller="PatientDashboard" asp-action="Index" class="btn btn-outline-light btn-lg">
                        Patient Dashboard
                    </a>
                </div>
            }
            else if (role == "Doctor")
            {
                <p class="hero-welcome">
                    Welcome back, <strong>@fullName</strong>.
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-light btn-lg">
                        View Appointment Requests
                    </a>

                    <a asp-controller="DoctorDashboard" asp-action="Index" class="btn btn-outline-light btn-lg">
                        Doctor Dashboard
                    </a>
                </div>
            }
        </div>

        <div class="col-lg-5 d-none d-lg-block">
            <div class="hero-card">
                <div class="hero-card-icon">🩺</div>
                <h4>Digital medical scheduling</h4>
                <p>
                    Manage appointment requests, confirmations, patient history and doctor feedback
                    in one centralized system.
                </p>

                <div class="hero-card-row">
                    <span>Patients</span>
                    <strong>Online requests</strong>
                </div>

                <div class="hero-card-row">
                    <span>Doctors</span>
                    <strong>Status control</strong>
                </div>

                <div class="hero-card-row">
                    <span>Hospitals</span>
                    <strong>Departments & services</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">👤</div>
            <h4>For Patients</h4>
            <p>
                Create appointment requests, choose hospitals, departments, doctors and track your medical history.
            </p>
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary">
                Make Appointment
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">🩺</div>
            <h4>For Doctors</h4>
            <p>
                Manage appointment requests, confirm, decline or complete consultations and add medical comments.
            </p>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-primary">
                Appointment Requests
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">🏥</div>
            <h4>Medical Institutions</h4>
            <p>
                Browse hospitals, departments and available medical services in a structured and clear format.
            </p>
            <a asp-controller="Hospitals" asp-action="Index" class="btn btn-primary">
                View Hospitals
            </a>
        </div>
    </div>
</div>

<div class="row g-4 text-center mb-4">
    <div class="col-md-3">
        <div class="stat-box h-100">
            <div class="stat-icon">🏥</div>
            <h3>3+</h3>
            <p>Medical institutions</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-box h-100">
            <div class="stat-icon">🧩</div>
            <h3>4+</h3>
            <p>Departments</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-box h-100">
            <div class="stat-icon">🩺</div>
            <h3>5+</h3>
            <p>Medical services</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-box h-100">
            <div class="stat-icon">🌐</div>
            <h3>24/7</h3>
            <p>Online access</p>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="mb-4">How it works</h4>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="how-step">
                    <div class="step-number">1</div>
                    <h6>Register</h6>
                    <p>Create an account as a patient or doctor.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="how-step">
                    <div class="step-number">2</div>
                    <h6>Choose institution</h6>
                    <p>Select hospital, department and doctor.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="how-step">
                    <div class="step-number">3</div>
                    <h6>Send request</h6>
                    <p>Choose date, service and describe your problem.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="how-step">
                    <div class="step-number">4</div>
                    <h6>Track status</h6>
                    <p>Follow appointment status and doctor comments.</p>
                </div>
            </div>
        </div>
    </div>
</div>